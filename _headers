# Security headers. Understood by both Cloudflare Pages and Netlify.
# The CSP below was verified against the app: all blocks render, the preview
# iframe populates, and no violations fire. If you add a new outbound host
# (another reader proxy, a font, an analytics script) you must add it here too
# or the browser will silently block it.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src https: data: blob:; connect-src https://r.jina.ai https://api.allorigins.win; frame-src 'self' data: blob:; frame-ancestors 'none'; base-uri 'none'; form-action 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
